# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required — get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Chat model (gpt-4o is the default; gpt-4o-mini is cheaper for testing)
MODEL_NAME=gpt-4o

# Embedding model — text-embedding-3-small is fast and cost-effective
EMBEDDING_MODEL=text-embedding-3-small

# Where ChromaDB stores its data (relative to main.py)
CHROMA_PATH=./vectorstore

# ChromaDB collection name — change only if you need multiple collections
CHROMA_COLLECTION=career_docs

# Document chunking — tune after reviewing retrieval quality
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Number of chunks retrieved per query
RETRIEVER_K=5

# Disable ChromaDB telemetry noise
ANONYMIZED_TELEMETRY=False
